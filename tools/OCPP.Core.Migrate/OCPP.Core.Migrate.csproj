<Project Sdk="Microsoft.NET.Sdk">

  <!-- One-off tool: copies the Azure SQL database to SQLite (docs/MIGRATIE-PI.md §4).
       Deliberately not part of OCPP.Core.sln, so it is not built or published by CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\OCPP.Core.Database\OCPP.Core.Database.csproj" />
  </ItemGroup>

</Project>
